{
  "name": "Cloud Development Resilience Lab",
  "image": "ghcr.io/serc-computing/devcontainers/python-api:1",
  "forwardPorts": [
    8000,
    8001
  ],
  "portsAttributes": {
    "8000": {
      "label": "Workshop API",
      "visibility": "private"
    },
    "8001": {
      "label": "Movie game",
      "visibility": "private"
    }
  },
  "postCreateCommand": "bash .devcontainer/scripts/check-features.sh && bash tools/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "Postman.postman-for-vscode",
        "github.vscode-github-actions"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}