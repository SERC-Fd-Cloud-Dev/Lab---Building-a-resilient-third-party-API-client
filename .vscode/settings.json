{
    // -----------------------------
    // GitHub Copilot – Student-safe
    // -----------------------------
    // Disable inline autocomplete suggestions from Copilot
    "github.copilot.nextEditSuggestions.enabled": false,
    "editor.inlineSuggest.enabled": false,
    // "github.copilot.completions.chat.enabled": false,

    // Use organisation custom agents
    // "github.copilot.chat.organizationCustomAgents.enabled": true,
    // experimental
    // "github.copilot.chat.organizationInstructions.enabled": true,

    // Make it clear in the UI that Copilot is mainly for chat
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": true,
        "scminput": false
    },

    // -----------------------------
    // General editing discipline
